<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.ikasaneip.ikasanstudio</id>
    <name>IkasanStudio</name>
    <vendor email="david.hilton@realistisolutions.co.uk" url="http://www.ikasan.org">Ikasan</vendor>

    <description>Ikasan Studio is the IDE for Ikasan Enterprise Service Bus</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <content>
        <module name="ikasanstudio.native-mcp" loading="optional"/>
    </content>

    <resource-bundle>messages.studioBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- User-submitted exception reports; JetBrains hosts the Marketplace backend. -->
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        <toolWindow factoryClass="org.ikasan.studio.intellij.toolwindow.DesignerToolWindowFactory"
                    id="Ikasan Studio"
                    anchor="right"
		    icon="/studio/icons/squid13x13.svg"
        />

        <backgroundPostStartupActivity implementation="org.ikasan.studio.intellij.ai.StudioAiStartupActivity"/>

        <backgroundPostStartupActivity
            implementation="org.ikasan.studio.intellij.onboarding.IkasanStudioOnboardingActivity"/>

        <applicationService
            serviceImplementation="org.ikasan.studio.intellij.settings.IkasanStudioSettings"/>

        <fileEditorProvider
            implementation="org.ikasan.studio.intellij.editor.IkasanStudioFileEditorProvider"/>

        <applicationConfigurable
            parentId="tools"
            instance="org.ikasan.studio.intellij.settings.IkasanStudioSettingsConfigurable"
            id="ikasan.studio.settings"
            key="ikasan.studio.settings.displayName"
            bundle="messages.studioBundle"/>

        <notificationGroup id="Ikasan Studio" displayType="BALLOON"
                           key="ikasan.studio.notification.group"
                           bundle="messages.studioBundle"/>
    </extensions>
    <actions>
        <group id="IkasanStudio.Tools" popup="true" icon="/studio/icons/squid13x13.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="IkasanStudio.GenerateVerification" class="org.ikasan.studio.intellij.testing.GenerateVerificationAction"/>
            <action id="IkasanStudio.GenerateFlowTest" class="org.ikasan.studio.intellij.testing.GenerateFlowTestAction"/>
            <separator/>
            <action id="IkasanStudio.MigrateVersion"
                    class="org.ikasan.studio.intellij.migration.MigrateIkasanVersionAction"/>
            <action id="IkasanStudio.RestoreMigration"
                    class="org.ikasan.studio.intellij.migration.RestoreIkasanMigrationAction"/>
            <action id="IkasanStudio.ExportOfflineTools"
                    class="org.ikasan.studio.intellij.migration.ExportOfflineToolsAction"/>
            <separator/>
            <action id="IkasanStudio.ReplaceReferences"
                    class="org.ikasan.studio.ui.actions.ReplaceReferencesAction"/>
            <separator/>
            <action id="IkasanStudio.ConnectAI"
                    class="org.ikasan.studio.intellij.ai.StudioAiConnectionAction"/>
            <action id="IkasanStudio.ImportAIProposal"
                    class="org.ikasan.studio.intellij.ai.StudioAiImportProposalAction"/>
            <action id="IkasanStudio.ReviewLatestAIProposal"
                    class="org.ikasan.studio.intellij.ai.StudioAiReviewLatestProposalAction"/>
            <separator/>
            <action id="IkasanStudio.CollectDiagnostics"
                    class="org.ikasan.studio.intellij.diagnostics.CollectStudioDiagnosticsAction"/>
            <separator/>
            <action id="IkasanStudio.OpenEditor"
                    class="org.ikasan.studio.intellij.editor.OpenIkasanStudioEditorAction"/>
        </group>
    </actions>
</idea-plugin>
