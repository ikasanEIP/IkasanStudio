{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ikasan.org/studio/metapack/metapack.schema.json",
  "title": "Ikasan Studio meta-pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "ikasanVersion",
    "javaVersion",
    "dependencyManagement",
    "compatibilityOverrides"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ikasanVersion": {
      "type": "string",
      "minLength": 1
    },
    "javaVersion": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "dependencyManagement": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coordinate"
      }
    },
    "compatibilityOverrides": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/coordinate"
          },
          {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "packVersion": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$"
    },
    "generatorApiVersion": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "artifactId",
        "version"
      ],
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "packVersion",
          "generatorApiVersion"
        ]
      }
    }
  ]
}
