<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.ikasan.studio</groupId>
  <artifactId>ikasan-studio-metapack-archetype</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>maven-archetype</packaging>
  <name>Ikasan Studio Meta-Pack Archetype</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <version>3.0.1</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <configuration><addDefaultExcludes>false</addDefaultExcludes></configuration>
        <executions>
          <execution>
            <id>maintained-example</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/archetype-resources</outputDirectory>
              <resources>
                <resource>
                  <directory>../example-metapack</directory>
                  <filtering>false</filtering>
                  <excludes>
                    <exclude>**/target/**</exclude>
                    <exclude>pom.xml</exclude>
                  </excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-archetype-plugin</artifactId>
        <version>3.3.1</version>
        <configuration><useDefaultExcludes>false</useDefaultExcludes></configuration>
      </plugin>
    </plugins>
  </build>
</project>